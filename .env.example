# Optional. Without a model, the lab uses a deterministic local synthesizer.
# Examples: anthropic:claude-sonnet-4-6 or openai:gpt-5.4-mini
MODEL=

# Configure the key required by the selected model provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Enable LangSmith tracing after creating an API key.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-support-lab
