# Optional. Without a model, the lab uses a deterministic local synthesizer.
# Examples: anthropic:claude-sonnet-4-6 or openai:gpt-5.4-mini
MODEL=

# Configure the key required by the selected model provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Live retrieval uses current LangChain docs, GitHub issues, and Forum topics.
# hybrid tries live sources first and falls back to data/knowledge.json.
RETRIEVAL_MODE=hybrid
RETRIEVAL_HTTP_TIMEOUT_SECONDS=10
RETRIEVAL_CACHE_TTL_SECONDS=300

# Optional. Public GitHub search works without a token but is limited to
# 10 search requests/minute and 60 general API requests/hour per IP.
GITHUB_TOKEN=
GITHUB_REPOSITORIES=langchain-ai/langchain,langchain-ai/langgraph

# Override these only when testing mirrors or alternate installations.
FORUM_BASE_URL=https://forum.langchain.com
DOCS_INDEX_URLS=https://docs.langchain.com/oss/python/llms.txt,https://docs.langchain.com/oss/python/langchain/llms.txt,https://docs.langchain.com/oss/python/langgraph/llms.txt,https://docs.langchain.com/oss/python/releases/llms.txt,https://docs.langchain.com/oss/python/migrate/llms.txt,https://docs.langchain.com/oss/javascript/llms.txt,https://docs.langchain.com/langsmith/llms.txt

# Enable LangSmith tracing after creating an API key.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-support-lab
